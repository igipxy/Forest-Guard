# ============================================================================
# SHARED SUPABASE CONFIGURATION (Required for production DB & Realtime)
# ============================================================================
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-here"

# ============================================================================
# MACHINE-TO-MACHINE AUTHENTICATION (monitoring-dashboard <-> camera-web)
# ============================================================================
# Shared secret verified via X-Internal-Api-Key header on /api/v1/cameras
CAMERA_API_SECRET="replace-with-32-byte-hex-secret-in-production"

# ============================================================================
# MONITORING DASHBOARD (Port 3000)
# ============================================================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
CAMERA_WEB_API_URL="http://localhost:3001/api/v1"
BMKG_API_BASE_URL="https://api.bmkg.go.id/publik/prakiraan-cuaca"
BMKG_DEFAULT_ADM4="35.73.01.1001"
NEXT_PUBLIC_ENABLE_DEMO_MODE="true"

# Optional Notification Integrations
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
ALERT_WEBHOOK_URL=""

# ============================================================================
# CAMERA MANAGEMENT WEB (Port 3001)
# ============================================================================
NEXT_PUBLIC_CAMERA_WEB_URL="http://localhost:3001"
STREAM_PROBE_TIMEOUT_MS="3500"